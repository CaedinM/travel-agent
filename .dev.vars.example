# Copy to .dev.vars for `npm run dev:cloudflare` only. Never commit real values.
# From a local container, host.docker.internal reaches services on your machine.
DATABASE_URL="postgresql://travel_agent:travel_agent_dev@host.docker.internal:5433/travel_agent"
# Supply an accessible Redis endpoint. Compose's Redis has no published host port.
REDIS_URL="rediss://default:replace-me@redis.example.com:6379/0"
OPENAI_API_KEY=""
TAVILY_API_KEY=""
TYPESAFE_API_KEY=""
DUFFEL_TEST_API_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""
CLERK_AUTHORIZED_PARTIES="http://localhost:8787"

# Model Providers
OPENAI_API_KEY=

# Monthly OpenAI token entitlements. Payment integration will set
# users.is_paying_customer; paid customers receive the paid allowance.
FREE_MONTHLY_TOKEN_LIMIT=75000
PAID_MONTHLY_TOKEN_LIMIT=750000
# Maximum budget held before a request starts; actual provider usage is charged.
CHAT_TOKEN_RESERVATION=8000
FLIGHT_SELECTION_TOKENS_PER_LEG=4000

# Web Search Tool
TAVILY_API_KEY=

# Langsmith Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Phoenix evaluation tracing. These are used only by manually run evaluation
# experiments; ordinary deterministic tests run without Phoenix credentials.
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=
PHOENIX_TRACING_ENABLED=false
PHOENIX_RUNTIME_PROJECT=travel-agent-runtime
PHOENIX_EVAL_PROJECT=travel-agent-evals
# Local developer traces are eligible for the advisory conversation-quality runner.
# Deployments must set this to production; production traces are excluded by default.
PHOENIX_TRACE_POPULATION=manual
PHOENIX_AGENT_MODEL_VERSION=gpt-5
PHOENIX_AGENT_PROMPT_VERSION=v1
# Set true only when the collector is trusted to retain conversation content.
PHOENIX_CAPTURE_CONTENT=false

# Duffel Flights
DUFFEL_TEST_API_KEY=

# Duffel live key, turn LIVE_MODE = true to activate
LIVE_MODE=false
DUFFEL_LIVE_API_KEY=

# Clerk Authentication
# The publishable key is safe to send to the browser; never expose the secret key.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional PEM public key for local JWT verification.
CLERK_JWT_KEY=
# Comma-separated origins allowed to send Clerk session tokens to this API.
CLERK_AUTHORIZED_PARTIES=http://localhost:8000
# Copy this from the Clerk webhook endpoint configuration. It verifies incoming
# user.created events before they are written to Postgres.
CLERK_WEBHOOK_SIGNING_SECRET=

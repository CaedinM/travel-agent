{
  "name": "travel-agentic-frontend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "vite build frontend --base /static/ --outDir dist",
    "test:frontend": "node --test frontend/*.test.mjs",
    "deploy": "railway up --service travel-agent",
    "build:container": "docker build --platform linux/amd64 --target production -t travel-agent:railway ."
  },
  "dependencies": {
    "@clerk/clerk-js": "6.34.1",
    "@clerk/ui": "1.36.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "vite": "8.3.1"
  }
}
